# Copy this file to .env and fill in the two keys. Nothing else is required.
#   cp .env.example .env
#
# The program runs without any keys (offline mode, stored fixtures, clearly labeled).
# With both keys it runs live: Whisper (local) -> Gemini -> Jev -> loss gate -> PDF.

# Google AI key for Gemini (the dialect-to-JSON step)
GOOGLE_API_KEY=

# TypeSafe key for Jev (the ESI probability step)
TYPESAFE_API_KEY=

# ---- Optional tuning (defaults shown) ----
# GEMINI_MODEL=gemini-3.8-flash
# JEV_MODEL=jev-latest
# WHISPER_MODEL=small
# GEMINI_TIMEOUT_S=8
# JEV_TIMEOUT_S=5
# C_UNDER=10
# C_OVER=1
# TRIAGE_OFFLINE=0
